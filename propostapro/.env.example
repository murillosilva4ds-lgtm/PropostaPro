# ---- Supabase ----
# Encontre em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
# Chave de serviço (NUNCA exponha no frontend, usada apenas em rotas server-side)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---- URL pública do app (usada para montar links de propostas e checkout) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Administradores (server-only; use e-mails confirmados ou IDs Supabase) ----
ADMIN_EMAILS=admin@example.com
# ADMIN_USER_IDS=uuid-do-usuario-admin

# ---- Administradores (server-only; use e-mails confirmados ou IDs do Supabase) ----
ADMIN_EMAILS=admin@example.com
# ADMIN_USER_IDS=uuid-do-usuario-admin

# ---- Stripe (pagamentos recorrentes) ----
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

# ---- Alternativa: Mercado Pago ----
# MERCADOPAGO_ACCESS_TOKEN=xxx
# MERCADOPAGO_WEBHOOK_SECRET=xxx

# ---- IA (geração de descrições e escopo) ----
# Pode usar Anthropic (Claude) ou OpenAI. Mantenha a chave só no backend.
ANTHROPIC_API_KEY=sk-ant-xxx
AI_PROVIDER=anthropic
